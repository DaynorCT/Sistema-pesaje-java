post_install() {
  echo "=> [ @APP_NAME@ ] Actualizando base de datos de aplicaciones..."
  update-desktop-database -q >/dev/null 2>&1 || true
}

post_upgrade() {
  post_install
}

post_remove() {
  echo "=> [ @APP_NAME@ ] Limpiando base de datos de aplicaciones..."
  update-desktop-database -q >/dev/null 2>&1 || true
}
